# Copia questo file, chiamalo ".env" e incolla la tua chiave dopo l'uguale.
# Il file .env resta solo sul tuo PC: non viene caricato su GitHub.

# OddsPapi (linee Snai / Sisal) - chiave gratuita su https://oddspapi.io
ODDS_PAPI_KEY=

# The Odds API (bookmaker USA, facoltativa)
ODDS_API_KEY=
# auto = sceglie quanti mercati scaricare per non superare i 500 crediti gratuiti al mese
ODDS_MARKETS=auto
